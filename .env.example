# ORLÉVANE — variables de entorno
#
# Copiá este archivo como .env.local para desarrollo, o cargá estas variables en
# el panel de Vercel. Ninguna es obligatoria: el sitio funciona sin ellas.

# Número de la boutique al que van los pedidos por WhatsApp.
# Sólo dígitos, con código de país y sin el signo +.
NEXT_PUBLIC_WHATSAPP_NUMBER=595982064334

# Dominio público del sitio. Se usa en metadatos, sitemap y robots.
NEXT_PUBLIC_SITE_URL=https://orlevane.vercel.app
